{
    "tasks": [
        {
          "label": "docker-build phcc",
          "type": "docker-build",
          "platform": "python",
          "dockerBuild":{
            "context": "${workspaceFolder}",
            "dockerfile":"${workspaceFolder}/run_test.dockerfile",
            "tag":"mine/pytest-homeassistant-custom-component:latest"
          }
        },
        {
            "label": "docker-run: debug",
            "type": "docker-run",
            "dependsOn": ["docker-build phcc"],
            "python": {
              "args": ["."],
              "module": "pytest"
            },
            "dockerRun":{
                "image":"mine/pytest-homeassistant-custom-component:latest",
                "volumes":[{
                    "localPath":"${workspaceFolder}",
                    "containerPath": "/app"
                }]
            }
        },
        {
            "label": "docker-run: debug 1 file",
            "type": "docker-run",
            "dependsOn": ["docker-build phcc"],
            "python": {
              "args": ["./tests/test_notifications.py"],
              "module": "pytest"
            },
            "dockerRun":{
                "image":"mine/pytest-homeassistant-custom-component:latest",
                "volumes":[{
                    "localPath":"${workspaceFolder}",
                    "containerPath": "/app"
                }]
            }
        },
        {
            "label": "HA Dev: Start",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml up -d",
            "problemMatcher": []
        },
        {
            "label": "HA Dev: Stop",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml down",
            "problemMatcher": []
        },
        {
            "label": "HA Dev: Restart",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml restart",
            "problemMatcher": []
        },
        {
            "label": "HA Dev: View Logs",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml logs -f",
            "problemMatcher": []
        }
    ]
}